-- ── HTTP REQUEST RESOLVER ──────────────────────────────────────────────────────
local req = request or http_request or (http and http.request) or (syn and syn.request)
local function doReq(opts)
    if syn and syn.request   then return syn.request(opts)
    elseif request           then return request(opts)
    elseif http_request      then return http_request(opts)
    else return {Body = game:HttpGet(opts.Url, true)} end
end

-- ── iOS / DELTA TELEPORT FIX ──────────────────────────────────────────────────
-- TeleportToPlaceInstance silently fails on Delta iOS (no error, just nothing happens).
-- Fix: try TeleportToPlaceInstance first, then fallback to Teleport (place-only),
-- wrapping each in pcall so one failure doesn't kill the loop.
-- Detection: Delta on iOS exposes identifyexecutor() returning "Delta"
local _isIOS = false
pcall(function()
    local id = (identifyexecutor and identifyexecutor()) or (getexecutorname and getexecutorname()) or ""
    _isIOS = id:lower():find("delta") ~= nil or id:lower():find("arceus") ~= nil
end)

local function safeTeleport(pid, jobId, player)
    -- Method 1: TeleportToPlaceInstance (works on PC/Android, may fail on iOS Delta)
    local ok1, err1 = pcall(function()
        TeleportService:TeleportToPlaceInstance(pid, jobId, player)
    end)
    if ok1 then return true, nil end

    -- Method 2: TeleportService:Teleport (iOS fallback — no jobId, lands in any server)
    -- Only use if method 1 failed with something other than RenderFidelity
    local errStr = tostring(err1)
    if errStr:find("RenderFidelity") then
        return true, nil  -- Ignore RenderFidelity — teleport actually fired
    end

    -- Method 3: game:GetService("TeleportService"):Teleport (alternate iOS path)
    local ok3 = pcall(function()
        TeleportService:Teleport(pid, player)
    end)
    if ok3 then return true, nil end

    return false, errStr
end

-- ── DECRYPTION DICTIONARY ─────────────────────────────────────────────────────
local dictionary = {
    ["5Rx"]="0",["6Sy"]="1",["7Tz"]="2",["8Ua"]="3",
    ["9Vb"]="4",["1Wc"]="5",["2Xd"]="6",["3Ye"]="7",
    ["4Zf"]="8",["5Ag"]="9",["xR7"]="a",["yS8"]="b",
    ["zT9"]="c",["aU1"]="d",["bV2"]="e",["cW3"]="f",
    ["6Bh"]="-"
}
local function decryptJobID(enc)
    if not enc then return "" end
    local out = ""
    for i = 1, #enc, 3 do
        local chunk = enc:sub(i, i+2)
        out = out .. (dictionary[chunk] or "?")
    end
    return out
end

