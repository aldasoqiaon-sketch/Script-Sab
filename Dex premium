                Size = UDim2.new(1, -16, 0, 36),
            }, 0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        else
            tween(btn, {
                TextColor3 = theme.textDark,
            })

            btn.Font = theme.font
        end
        if pages[name] then
            if isSelected then
                pages[name].Visible = true
                pages[name].GroupTransparency = 1

                tween(pages[name], {GroupTransparency = 0}, 0.3)
            else
                pages[name].Visible = false
            end
        end
    end
end

