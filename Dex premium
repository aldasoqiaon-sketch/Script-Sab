local function updateStatus(connected, extraText)
    local text = extraText or (connected and 'Connected' or 'Idle')
    local color = connected and theme.green or theme.muted

    if not connected and extraText then
        local lower = tostring(extraText):lower()

        if lower:find('connect') or lower:find('reconnect') then
            color = theme.orange
        elseif lower:find('fail') or lower:find('error') then
            color = theme.red
        end
    end

    tween(statusDot, {BackgroundColor3 = color})
    tween(statusLabel, {TextColor3 = color})
    pcall(function()
        statusLabel.Text = text
    end)
end

