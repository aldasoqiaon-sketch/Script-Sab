        Parent = row,
    })
    create('UIStroke', {
        Color = Color3.fromRGB(40, 45, 60),
        Transparency = 0.3,
        Thickness = 1,
        Parent = row,
    })
    create('TextLabel', {
        Size = UDim2.new(0, 200, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = theme.text,
        TextSize = 12,
        Font = theme.fontBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 4,
        Parent = row,
    })

    local toggleBg = create('TextButton', {
        Name = 'SwitchBg_' .. configKey,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.new(0, 44, 0, 24),
        BackgroundColor3 = Color3.fromRGB(35, 40, 50),
        BorderSizePixel = 0,
        Text = '',
        AutoButtonColor = false,
        ZIndex = 4,
        Parent = row,
    })

    create('UICorner', {
        CornerRadius = UDim.new(1, 0),
        Parent = toggleBg,
    })

    local knob = create('Frame', {
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(0, 2, 0.5, -10),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        ZIndex = 5,
        Parent = toggleBg,
    })

    create('UICorner', {
        CornerRadius = UDim.new(1, 0),
        Parent = knob,
    })

    local function refresh()
        local stateVal = config[configKey]

        tween(toggleBg, {
            BackgroundColor3 = stateVal and theme.accent or Color3.fromRGB(35, 40, 50),
        }, 0.3)
        tween(knob, {
            Position = stateVal and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10),
        }, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end

    refresh()
    toggleBg.MouseButton1Click:Connect(function()
        config[configKey] = not config[configKey]

        refresh()
        saveCfg()

        if onToggle then
            onToggle(config[configKey])
        end
    end)

    return row
end

